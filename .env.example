# Copy to .env and fill in your Supabase project values
# (Supabase dashboard -> Project Settings -> API Keys)
# Public values — safe to expose in the browser bundle.
VITE_SUPABASE_URL=https://iqrfcdrhsgtyxijdpicl.supabase.co
# Preferred: the new publishable key (sb_publishable_...).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback (still accepted by the code, but prefer the publishable key).
# VITE_SUPABASE_ANON_KEY=eyJ...legacy anon JWT...

# --- Staff passwords (LOCAL SCRIPTS ONLY — never used by the browser app) ---
# Required by npm run test:smoke, test:sync, seed:business, seed:auth,
# restore:menu and repair:menu-seq, all of which sign in to Supabase as a
# staff member. They are NOT prefixed with VITE_ on purpose, so they are never
# bundled into the browser. Keep the real values in .env, which is gitignored.
POS_CASHIER_PASSWORD=...
POS_MANAGER_PASSWORD=...