# Dependencies
node_modules/

# Build output
dist/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local env files — never commit secrets
# Order matters: the broad patterns must come BEFORE the negation, otherwise
# they override it and .env.example itself becomes ignored.
.env
.env*
!.env.example

# Vercel CLI
.vercel
