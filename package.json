    "check:live": "node --env-file=.env scripts/check-live.mjs",
    "assets:sizes": "node scripts/image-size.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.10.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
