{
  "name": "maison-de-luxe-pos-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Maison de Luxe POS - React + Tailwind CSS + Vite point-of-sale system",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed:business": "node scripts/seed-business.mjs",
    "seed:auth": "node scripts/seed-auth.mjs",
    "restore:menu": "node --env-file=.env scripts/restore-menu.mjs --apply",
    "repair:menu-seq": "node --env-file=.env scripts/repair-menu-sequence.mjs",
    "test:sync": "node --env-file=.env scripts/test-sync-flow.mjs",
    "test:smoke": "node --env-file=.env scripts/smoke-test.mjs",
